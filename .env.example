HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins allowed to call FaceService directly
# Use the deployed FEDMS origin for ngrok-backed testing
CORS_ALLOW_ORIGINS=https://fedms.vercel.app

# BEDMS callback URL for the deployed BEDMS instance
BEDMS_CALLBACK_URL=https://bedms-production.up.railway.app/v1/face-recognition/callback

# Shared API key for service-to-service auth (must match BEDMS .env)
FACE_SERVICE_API_KEY=change_me

# InsightFace model name (buffalo_l recommended for accuracy)
INSIGHTFACE_MODEL=buffalo_l

# GPU device ID (0 = first GPU, -1 = CPU only)
# Use -1 if the remote server does not have a usable GPU
GPU_DEVICE_ID=0

# Detection settings
DET_SIZE=640
MIN_FACE_SIZE=50
